#!/bin/bash
# GenerateAssets - Converts raw assets into C header byte arrays and updates Master Header

ASSET_DIR="BlockEngine/src/Assets/BlockEngine"
OUT_DIR="BlockEngine/src/Assets/BlockEngine/GeneratedAssets"
MASTER_HEADER="$OUT_DIR/GeneratedAssets.hpp"

# Ensure output folders exist
mkdir -p "$OUT_DIR/Audio" "$OUT_DIR/Images" "$OUT_DIR/Shaders"

# Clean old generated headers to prevent stale references
rm -f "$OUT_DIR/Audio"/*.h "$OUT_DIR/Images"/*.h "$OUT_DIR/Shaders"/*.h

echo "Generating asset byte arrays..."

# 1. Embed Audio (.mp3, .wav)
find "$ASSET_DIR/Audio" -type f \( -name "*.mp3" -o -name "*.wav" \) | while read -r f; do
    filename=$(basename "$f" | sed 's/[^a-zA-Z0-9]/_/g')
    xxd -i "$f" > "$OUT_DIR/Audio/asset_${filename}.h"
done

# 2. Embed Images (.png)
find "$ASSET_DIR/Images" -type f -name "*.png" | while read -r f; do
    filename=$(basename "$f" | sed 's/[^a-zA-Z0-9]/_/g')
    xxd -i "$f" > "$OUT_DIR/Images/asset_${filename}.h"
done

# 3. Embed Shaders (.vert, .frag)
find "$ASSET_DIR/Shaders" -type f \( -name "*.vert" -o -name "*.frag" \) | while read -r f; do
    filename=$(basename "$f" | sed 's/[^a-zA-Z0-9]/_/g')
    xxd -i "$f" > "$OUT_DIR/Shaders/asset_${filename}.h"
done

# --- 4. Generate GeneratedAssets.hpp ---
echo "Building $MASTER_HEADER..."

cat << 'EOF' > "$MASTER_HEADER"
#pragma once

// Auto-generated by ./GenerateAssets - DO NOT EDIT MANUALLY

// ==========================================
// Audio Assets
// ==========================================
EOF

for header in "$OUT_DIR/Audio"/*.h; do
    [ -f "$header" ] && echo "#include \"Audio/$(basename "$header")\"" >> "$MASTER_HEADER"
done

cat << 'EOF' >> "$MASTER_HEADER"

// ==========================================
// Image Assets
// ==========================================
EOF

for header in "$OUT_DIR/Images"/*.h; do
    [ -f "$header" ] && echo "#include \"Images/$(basename "$header")\"" >> "$MASTER_HEADER"
done

cat << 'EOF' >> "$MASTER_HEADER"

// ==========================================
// Shader Assets
// ==========================================
EOF

for header in "$OUT_DIR/Shaders"/*.h; do
    [ -f "$header" ] && echo "#include \"Shaders/$(basename "$header")\"" >> "$MASTER_HEADER"
done

echo "Assets generated successfully in $OUT_DIR"
